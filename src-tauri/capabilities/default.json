{
  "$schema": "https://schema.tauri.app/config/2/capabilities/capability",
  "identifier": "default",
  "description": "Default capability for Idle Hacker Tycoon",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-set-size",
    "core:window:allow-center",
    "core:app:default",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:default",
    "process:allow-restart"
  ]
}
