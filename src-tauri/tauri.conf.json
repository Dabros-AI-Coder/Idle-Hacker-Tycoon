{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Idle Hacker Tycoon",
  "version": "0.6.0",
  "identifier": "com.dabros.idle-hacker-tycoon",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Idle Hacker Tycoon",
        "width": 560,
        "height": 800,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
